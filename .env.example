# Copy this file to .env.local and fill in values from your Meta app.

# App ID from the Instagram product / Meta app dashboard.
INSTAGRAM_APP_ID=

# App Secret from the Meta app dashboard.
INSTAGRAM_APP_SECRET=

# Optional legacy Facebook Login settings. MuseInbox's primary comment-to-DM
# flow uses Instagram Business Login below.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_LOGIN_CONFIG_ID=

# OAuth callback URL. For local testing this should be your ngrok URL plus
# /api/auth/instagram/callback, and it must exactly match the redirect URI
# configured in your Meta app.
INSTAGRAM_OAUTH_REDIRECT_URI=

# Optional legacy Facebook OAuth callback URL.
FACEBOOK_OAUTH_REDIRECT_URI=

# Permissions requested by the Connect Instagram button.
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_manage_messages,instagram_business_manage_comments

# Optional Facebook scopes.
FACEBOOK_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_messaging,business_management

# Meta uses this during webhook setup. Pick a long random value and paste
# the same value into Meta's webhook Verify Token field.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# Optional fallback. Normally this is filled by the Instagram OAuth connection flow now.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Defaults to v25.0 if omitted.
INSTAGRAM_GRAPH_VERSION=v25.0

# Set to true to receive and log webhook matches without sending private replies.
INSTAGRAM_DRY_RUN=false

# Supabase persistent storage. Use the project URL and service role key from
# Supabase Project Settings > API. The service role key must stay server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required when Supabase storage is enabled. Use a long random value.
APP_ENCRYPTION_KEY=

# Optional. Used to sign the MuseInbox login session cookie. If omitted,
# APP_ENCRYPTION_KEY is used.
APP_SESSION_SECRET=
